# =============================================================================
# Eloquentia - Exemple de configuration d'environnement (exhaustif)
# =============================================================================
# Ce fichier documente TOUTES les variables du projet. Il ne contient aucun
# secret reel. Copiez les sections vers les fichiers .env reels :
#
#   cp server/.env.example server/.env      # backend + Prisma (lit server/.env)
#   cp web/.env.example    web/.env         # frontend Vite   (lit web/.env)
#
# Ne committez jamais vos fichiers .env (ils sont gitignores).
# =============================================================================


# -----------------------------------------------------------------------------
# SERVER (API Express) - a placer dans server/.env
# -----------------------------------------------------------------------------

# Environnement d'execution : development | test | production
NODE_ENV=development

# Port d'ecoute de l'API. En prod (Railway), la plateforme fournit PORT.
PORT=4000

# Connexion runtime a PostgreSQL (utilisee par le client Prisma).
# --- Local (Postgres Homebrew ou docker-compose) :
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eloquentia?schema=public
# --- Supabase (prod) : utilisez le POOLER (port 6543) avec pgbouncer :
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Connexion DIRECTE a PostgreSQL (utilisee uniquement par les migrations Prisma).
# --- Local : identique a DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/eloquentia?schema=public
# --- Supabase (prod) : connexion directe (port 5432, sans pooler) :
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Secret de signature des JWT (chaine longue et aleatoire). OBLIGATOIRE.
# Generer par exemple avec : openssl rand -base64 48
JWT_SECRET=remplacez-moi-par-un-secret-long-et-aleatoire

# Origine autorisee pour CORS (URL du front).
# --- Local :
CORS_ORIGIN=http://localhost:5173
# --- Prod : l'URL Vercel du front, ex. https://eloquentia.vercel.app

# Niveau de log Pino : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Cle API Brevo (emails). Optionnelle tant que l'emailing n'est pas branche.
# BREVO_API_KEY=


# -----------------------------------------------------------------------------
# WEB (SPA React / Vite) - a placer dans web/.env
# -----------------------------------------------------------------------------
# Seules les variables prefixees VITE_ sont exposees au navigateur.

# URL de base de l'API consommee par le front.
# --- Local :
VITE_API_BASE_URL=http://localhost:4000/api/v1
# --- Prod : l'URL Railway de l'API, ex. https://eloquentia-api.up.railway.app/api/v1
