# Frontend (Vite). Copier en web/.env :  cp web/.env.example web/.env
# Seules les variables préfixées VITE_ sont exposées au navigateur.

VITE_API_BASE_URL=http://localhost:4000/api/v1

# JWT de dev pour tester les routes backend authentifiées (pièces jointes).
# Générer : npm run mint-token -- --id=dev --role=ADMIN --hours=24
VITE_DEV_TOKEN=
