# Backend (API Express + Prisma). Copier en server/.env :  cp server/.env.example server/.env
# Voir le .env.example racine pour la documentation complete (Supabase, etc.).

NODE_ENV=development
PORT=4000

# PostgreSQL - runtime (client Prisma).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eloquentia?schema=public
# PostgreSQL - direct (migrations Prisma).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/eloquentia?schema=public

# Secret JWT (obligatoire). Generer : openssl rand -base64 48
JWT_SECRET=remplacez-moi-par-un-secret-long-et-aleatoire

# Origine CORS (URL du front).
CORS_ORIGIN=http://localhost:5173

# Logs : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Cle API Brevo (optionnelle).
# BREVO_API_KEY=
